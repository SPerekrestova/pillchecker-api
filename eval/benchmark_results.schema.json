{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SPerekrestova/pillchecker-api/eval/benchmark_results.schema.json",
  "title": "PillChecker benchmark results",
  "type": "object",
  "additionalProperties": true,
  "required": ["overall", "timing", "ner", "linking", "rxnorm", "interactions", "errors", "fp_taxonomy"],
  "properties": {
    "overall": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "records_total",
        "records_completed",
        "records_errored",
        "error_rate",
        "timeout_count",
        "concurrency",
        "wall_time_seconds",
        "records_per_second"
      ],
      "properties": {
        "records_total": {"type": "integer", "minimum": 0},
        "records_completed": {"type": "integer", "minimum": 0},
        "records_errored": {"type": "integer", "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "timeout_count": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "records_per_second": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["components", "slowest_component", "slowest_component_counts"],
      "properties": {
        "components": {"type": "object"},
        "slowest_component": {"type": ["string", "null"]},
        "slowest_component_counts": {"type": "object"}
      }
    },
    "ner": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "strict",
        "lenient",
        "per_category",
        "per_noise_level",
        "confidence_sweep",
        "score_distribution",
        "n_records_scored"
      ],
      "properties": {
        "strict": {"$ref": "#/$defs/prf"},
        "lenient": {"$ref": "#/$defs/prf"},
        "per_category": {"type": "object"},
        "per_noise_level": {"type": ["object", "null"]},
        "confidence_sweep": {"type": "object"},
        "score_distribution": {"type": "object"},
        "n_records_scored": {"type": "integer", "minimum": 0}
      }
    },
    "linking": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "coverage",
        "fallback_rate",
        "nil_rate",
        "n_link_attempts",
        "n_drugs_total",
        "acc_at_1",
        "incorrect_link_rate"
      ],
      "properties": {
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "fallback_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "nil_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "n_link_attempts": {"type": "integer", "minimum": 0},
        "n_drugs_total": {"type": "integer", "minimum": 0},
        "acc_at_1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "incorrect_link_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "rxnorm": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "coverage",
        "fallback_rate",
        "nil_rate",
        "n_link_attempts",
        "n_drugs_total",
        "acc_at_1",
        "incorrect_link_rate",
        "n_rxnorm_attempts",
        "rxnorm_by_method",
        "unresolved_queries",
        "canonicalization_collisions"
      ]
    },
    "interactions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["descriptive", "accuracy", "seed_smoke"],
      "properties": {
        "descriptive": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "total_pairs_checked",
            "ddinter_hit_rate",
            "openfda_hit_rate",
            "unknown_rate",
            "severity_distribution",
            "uncertain_rate",
            "records_with_any_interaction",
            "ddinter_rxcui_hit_rate",
            "ddinter_fts_rescue_rate",
            "openfda_rescue_rate",
            "source_counts",
            "top_unknown_pairs"
          ],
          "properties": {
            "total_pairs_checked": {"type": "integer", "minimum": 0},
            "ddinter_hit_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "openfda_hit_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "unknown_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "severity_distribution": {"$ref": "#/$defs/severity_counts"},
            "uncertain_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "records_with_any_interaction": {"type": "integer", "minimum": 0},
            "ddinter_rxcui_hit_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "ddinter_fts_rescue_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "openfda_rescue_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "source_counts": {"type": "object"},
            "top_unknown_pairs": {"type": "array"}
          }
        },
        "accuracy": {"type": ["object", "null"]},
        "seed_smoke": {
          "type": "object",
          "additionalProperties": true,
          "required": ["recall", "false_alarm_rate", "severity_accuracy", "missed_pairs"],
          "properties": {
            "recall": {"type": "number", "minimum": 0, "maximum": 1},
            "false_alarm_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "severity_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
            "missed_pairs": {"type": "array"}
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total", "by_stage", "by_class", "records"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_stage": {"type": "object"},
        "by_class": {"type": "object"},
        "records": {"type": "array"}
      }
    },
    "fp_taxonomy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "brand",
        "salt",
        "form",
        "mfg",
        "numeric",
        "excipient",
        "other",
        "total_fp",
        "n_records_scored"
      ],
      "properties": {
        "brand": {"$ref": "#/$defs/taxonomy_bucket"},
        "salt": {"$ref": "#/$defs/taxonomy_bucket"},
        "form": {"$ref": "#/$defs/taxonomy_bucket"},
        "mfg": {"$ref": "#/$defs/taxonomy_bucket"},
        "numeric": {"$ref": "#/$defs/taxonomy_bucket"},
        "excipient": {"$ref": "#/$defs/taxonomy_bucket"},
        "other": {"$ref": "#/$defs/taxonomy_bucket"},
        "total_fp": {"type": "integer", "minimum": 0},
        "n_records_scored": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "prf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "f1"],
      "properties": {
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "severity_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minor", "moderate", "major", "unknown"],
      "properties": {
        "minor": {"type": "integer", "minimum": 0},
        "moderate": {"type": "integer", "minimum": 0},
        "major": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "taxonomy_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "examples"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "examples": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
